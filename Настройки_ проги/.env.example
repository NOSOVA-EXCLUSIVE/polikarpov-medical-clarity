# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evgeny_ortho
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/evgeny_ortho

# Security
ENCRYPTION_KEY_BASE64=replace_with_32_byte_key_base64
TOKEN_HASH_SECRET=replace_with_token_hash_secret
STAFF_SESSION_SECRET=replace_with_staff_session_secret
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace_with_strong_password
ADMIN_SEED_NAME=Practice Admin

# S3-compatible storage
S3_REGION=auto
S3_BUCKET=evgeny-ortho-private
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY_ID=replace_with_access_key
S3_SECRET_ACCESS_KEY=replace_with_secret_key
S3_FORCE_PATH_STYLE=true

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Postmark
POSTMARK_SERVER_TOKEN=replace_with_postmark_server_token
POSTMARK_FROM_EMAIL=no-reply@example.com
POSTMARK_REPLY_TO_EMAIL=care@example.com

# Inngest
INNGEST_APP_ID=evgeny-ortho-online
INNGEST_EVENT_KEY=replace_with_inngest_event_key
INNGEST_SIGNING_KEY=replace_with_inngest_signing_key

# Defaults
DEFAULT_CURRENCY=EUR
DEFAULT_HELD_SLOT_TTL_MINUTES=20
DEFAULT_OFFER_TTL_HOURS=72
DEFAULT_PORTAL_ACCESS_TTL_HOURS=24
DEFAULT_MATERIALS_TTL_HOURS=168

# Legal document versions
LEGAL_OFFER_VERSION=2026-04-09
LEGAL_PRIVACY_VERSION=2026-04-09
LEGAL_CONSENT_VERSION=2026-04-09
